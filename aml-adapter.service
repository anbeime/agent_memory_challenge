[Unit]
Description=Antinet-AML Adapter (Agent Memory Challenge)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/agent_memory_challenge
ExecStart=/opt/agent_memory_challenge/.venv/bin/python app.py
Environment=AML_PORT=8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
