# 复制为 .env 并填入真实值。.env 禁止提交。
LDBD_KEY=your_ldbd_key_here
AML_API_KEY=your_ldbd_key_here
AML_PORT=8080
# bm25 | agent | card
#   bm25 = 纯本地关键词（离线、最稳）
#   agent = BM25 粗排 + 米鱼菜菜 gateway (auto) LLM 重排（仅开放方法赛道）
#   card  = 四色卡模式：BM25 主召回 + 实体图谱 1 跳联想扩展（零 LLM、零延迟、保真）
RETRIEVAL_MODE=bm25
# 四色卡联想扩展的最小共享实体数（RETRIEVAL_MODE=card 时生效）
CARD_MIN_SHARED=2
# 强制保留给高 shared 联想的末位 slot 数
CARD_RESERVE_SLOTS=1
# 分词器：nlp（默认，自然语言/Textual）| code（Coding 赛道：camelCase 边界切分 + 保留数字）
# 切换会改变索引，缓存文件名与签名均含该模式，故两套索引互不覆盖
AML_TOKENIZER=nlp
# 数据库路径（多赛道并行时用不同 DB 隔离 user_id 空间）
# AML_DB_PATH=/path/to/aml_code.db
# 低于此分的弱匹配视为噪声丢弃（H 认识论安全）
AML_MIN_SCORE=0.03
# 米鱼菜菜 gateway（agent 模式可选 LLM 重排；仅开放方法赛道）
GATEWAY_URL=https://api1.miyucaicai.cn/api/ai/chat/completions
GATEWAY_TOKEN=
GATEWAY_MODEL=auto
# 网关单次调用超时（秒）：超过即回退 BM25
GATEWAY_TIMEOUT=8
# 网关连续失败达到此次数 -> 熔断，本进程剩余请求直接走 BM25
GATEWAY_MAX_FAILURES=5
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
